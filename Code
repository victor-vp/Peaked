def read_multiline(prompt: str) -> str:
    """Read pasted code until END_MARKER on its own line (or end of input)."""
    print(prompt)
    print(f"(Type {END_MARKER} on a new line when you are finished.)")
    lines = []
    while True:
        try:
            line = input()
        except EOFError:
            break
        if line.strip() == END_MARKER:
            break
        lines.append(line)
    return "\n".join(lines)


def run_demo():
    print("Example explanations:\n")
    for language, snippet in EXAMPLE_SNIPPETS.items():
        print(f"[{language.upper()}]")
        print(explain_code(snippet, language))
        print("-" * 50)


def chat_with_ai():
    """Simple chat loop using the OpenAI Responses API. Type 'quit' to go back to the menu."""
    # The client is created here, not at import time, so the code explainer
    # still works when the openai package or API key is missing.
    try:
        from openai import OpenAI
        client = OpenAI()
    except ImportError:
        print("The 'openai' package is not installed. Run: pip install openai")
        return
    except Exception as error:  # for example, OPENAI_API_KEY is not set
        print(f"Could not start the AI chat: {error}")
        print("Set the OPENAI_API_KEY environment variable and try again.")
        return

    print("\nAI Chatbot")
    print("Type 'quit' to go back to the menu.\n")

    while True:
        try:
            user_message = input("You: ").strip()
        except EOFError:
            break

        if user_message.lower() == "quit":
            break
        if not user_message:
            continue

        try:
            response = client.responses.create(
                model=OPENAI_MODEL,
                input=user_message,
            )
        except Exception as error:
            print(f"AI request failed: {error}\n")
            continue

        print("AI:", response.output_text, "\n")


def ask_language():
    """Ask the person to pick a language. Returns None if the answer is not recognised."""
    try:
        answer = input(f"Language ({', '.join(SUPPORTED_LANGUAGES)}): ").strip().lower()
    except EOFError:
        return None
    if answer not in SUPPORTED_LANGUAGES:
        print("Language not recognised. Try again.")
        return None
    return answer


def explain_pasted_code(language=None):
    """Read pasted code and explain it. With no language given, it is detected."""
    label = f"{language.upper()} code" if language else "your code"
    code = read_multiline(f"Paste {label} here:")
    if not code.strip():
        print("No code entered.")
        return

    if language is None:
        language = detect_language(code)
        # A bare value like 1234 has no language, so don't claim one was detected.
        if not is_only_values(code, language):
            print(f"\nDetected language: {language.upper()}")
            print("(Wrong guess? Use option 2 to choose the language yourself.)")

    print("\nSimple explanation:\n")
    print(explain_code(code, language))
    print("\n")


def main():
    print("Welcome to the Code Explanation Bot!")

    while True:
        print(HELP_TEXT)
        try:
            choice = input("Choose an option: ").strip()
        except EOFError:
            print("\nGoodbye!")
            break

        if choice == "0":
            print("Goodbye!")
            break
        elif choice == "1":
            explain_pasted_code()
        elif choice == "2":
            language = ask_language()
            if language:
                explain_pasted_code(language)
        elif choice == "3":
            run_demo()
        elif choice == "4":
            chat_with_ai()
        else:
            print("Invalid option. Try again.")


if __name__ == "__main__":
    main()
